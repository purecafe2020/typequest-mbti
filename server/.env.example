# ============================================
# TypeQuest PayPal 配置
# 先去 https://developer.paypal.com/ 注册 Sandbox 账号
# 创建 App 后获得以下两个值
# ============================================

# Sandbox 环境（测试）
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=你的SandboxClientID
PAYPAL_CLIENT_SECRET=你的SandboxSecret

# 上线后换成 live：
# PAYPAL_ENV=live
# PAYPAL_CLIENT_ID=你的LiveClientID
# PAYPAL_CLIENT_SECRET=你的LiveSecret

# 后端端口
PORT=3000

# 前端地址（PayPal 付款成功/取消后回跳用）
FRONTEND_URL=http://localhost:8080
